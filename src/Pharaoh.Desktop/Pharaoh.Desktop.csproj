<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
    <AssemblyName>Nesutera</AssemblyName>
    <Product>Nesutera</Product>
    <AssemblyTitle>Nesutera</AssemblyTitle>
    <RootNamespace>Pharaoh.Desktop</RootNamespace>
    <ApplicationIcon>Assets\Branding\Nesutera.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pharaoh.Assets\Pharaoh.Assets.csproj" />
    <ProjectReference Include="..\Pharaoh.Engine\Pharaoh.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Cursors\*.png" />
    <EmbeddedResource Include="Assets\Branding\Nesutera.ico" />
  </ItemGroup>
</Project>
